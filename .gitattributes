# Store text as LF in the repository and check it out as LF on every platform, so Prettier and
# ESLint see the same bytes on Windows and in CI.
* text=auto eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf

# Binary files: never normalise or diff as text.
*.png binary
*.jpg binary
*.jar binary
*.keystore binary
